(version 1)
(rule "U1 fine-pitch escape"
	(constraint clearance (min 0.2mm))
	(condition "A.intersectsCourtyard('U1') && B.intersectsCourtyard('U1')"))
(rule "U1 pin-to-pin (TI land pattern)"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U1') && B.memberOfFootprint('U1')"))
(rule "U2 fine-pitch escape"
	(constraint clearance (min 0.2mm))
	(condition "A.intersectsCourtyard('U2') && B.intersectsCourtyard('U2')"))
(rule "U2 pin-to-pin (TI land pattern)"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U2') && B.memberOfFootprint('U2')"))
(rule "U3 fine-pitch escape"
	(constraint clearance (min 0.2mm))
	(condition "A.intersectsCourtyard('U3') && B.intersectsCourtyard('U3')"))
(rule "U3 pin-to-pin (TI land pattern)"
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('U3') && B.memberOfFootprint('U3')"))
